---
const services = ["Freelance", "Video Editing", "Email Marketing Design", "Web Design", "Web Builder"];
// The list is repeated so the loop looks seamless.
const loop = [...services, ...services, ...services, ...services];
---

<section class="overflow-hidden bg-black py-5 text-white md:py-[25px]" aria-label="Services">
  <ul class="marquee flex w-max items-center text-base font-light md:text-2xl">
    {loop.map((s, i) => (
      <li class="flex shrink-0 items-center" aria-hidden={i >= services.length ? "true" : undefined}>
        <span class="whitespace-nowrap px-6 md:px-[27px]">{s}</span>
        <span class="size-2 rounded-full bg-white md:size-2.5" aria-hidden="true" />
      </li>
    ))}
  </ul>
</section>

<style>
  .marquee {
    animation: marquee 30s linear infinite;
  }
  .marquee:hover {
    animation-play-state: paused;
  }
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      animation: none;
    }
  }
</style>
