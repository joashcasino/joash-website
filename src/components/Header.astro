---
const links = [
  { label: "Projects", href: "#projects" },
  { label: "My Story", href: "#about" },
  { label: "Collab", href: "#contact" },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-[1313px] items-center justify-between gap-6 px-5 md:h-[87px] md:pl-[23px] md:pr-[46px]">
    <a href="#top" aria-label="Home">
      <img src="/images/logo.svg" alt="VANV logo" class="h-10 w-auto md:h-[62px]" />
    </a>
    <nav class="flex items-center gap-4 whitespace-nowrap text-sm sm:gap-10 md:gap-[60px] md:text-base">
      {links.map((l) => (
        <a href={l.href} class="transition-opacity hover:opacity-60">{l.label}</a>
      ))}
    </nav>
  </div>
</header>
