---
import ProjectCard from "./ProjectCard.astro";

// youtube: the video ID from the YouTube link (the part after /shorts/ or watch?v=).
const projects = [
  { title: "OMII Website", youtube: "VqmPHMXqPRM", tools: ["Claude AI - Agentic system", "Codex", "Shopify", "VS Code"] },
  { title: "TFC Video Edit", youtube: "oV_YszMlSuk", tools: ["Claude MCP", "ChatGPT Mcp", "Higgsfield", "Adobe Creative Cloud", "Premiere Pro", "Capcut"], reverse: true, lineLeft: true },
  { title: "Email Designs", youtube: "XvmPJZRVr48", tools: ["Figma", "Adobe Firefly", "Pinterest", "Dribbble"] },
];
---

<section
  id="projects"
  class="scroll-mt-16 overflow-hidden bg-black bg-cover bg-center px-6 py-24 md:min-h-[1484px] md:scroll-mt-[87px] md:pb-[160px] md:pt-[156px]"
  style="background-image: url('/images/bg-showcase.jpg');"
>
  <div class="mx-auto flex max-w-[1166px] flex-col gap-10 md:gap-0">
    {projects.map((p) => <ProjectCard {...p} />)}
  </div>
</section>
